{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32G474RE: ST-LINK Debug",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/build/debug/differential_swerve_firmware.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "stlink",
      "device": "STM32G474RE",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Firmware: Build Debug",
      "gdbPath": "${env:LOCALAPPDATA}\\stm32cube\\bundles\\gnu-gdb-for-stm32\\14.3.1+st.2\\bin\\arm-none-eabi-gdb.exe",
      "serverpath": "${env:LOCALAPPDATA}\\stm32cube\\bundles\\stlink-gdbserver\\7.13.0+st.3\\bin\\ST-LINK_gdbserver.exe",
      "stm32cubeprogrammer": "${env:LOCALAPPDATA}\\stm32cube\\bundles\\programmer\\2.22.0+st.1\\bin"
    }
  ]
}
