(text "J20 JST-GH 4pin: 1=GND, 2=I2C0_SDA, 3=I2C0_SCL, 4=+5V_SYS (module supply is 4-9V)." (exclude_from_sim no) (at 110 107 0) (effects (font (size 1.1 1.1))) (uuid "8c13a94b-3680-46eb-87ba-aef36e020ab5"))
(text "Default I2C address 69 / 0x45; jumpers permit 68 / 0x44 or 65 / 0x41. No ALERT wire in this interface." (exclude_from_sim no) (at 110 114 0) (effects (font (size 1.1 1.1))) (uuid "330c535c-8d25-4525-83f2-deb415132b77"))
