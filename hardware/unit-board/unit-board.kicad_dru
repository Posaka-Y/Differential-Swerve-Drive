(version 1)

# Rev.A baseline rules. Manufacturer-specific stackup and impedance rules are
# intentionally deferred until the PCB vendor is selected.

(rule "HSE tracks stay on front copper"
  (condition "A.NetClass == 'HSE' && A.Type == 'Track' && A.Layer != 'F.Cu'")
  (constraint disallow track))

(rule "HSE vias are forbidden"
  (condition "A.NetClass == 'HSE'")
  (constraint disallow via))

(rule "HSE minimum clearance"
  (condition "A.NetClass == 'HSE'")
  (constraint clearance (min 0.25mm)))

(rule "CAN baseline geometry"
  (condition "A.NetClass == 'CAN'")
  (constraint track_width (min 0.25mm))
  (constraint clearance (min 0.20mm)))

(rule "5V baseline geometry"
  (condition "A.NetClass == 'POWER_5V'")
  (constraint track_width (min 0.75mm))
  (constraint clearance (min 0.25mm)))

(rule "3V3 baseline geometry"
  (condition "A.NetClass == 'POWER_3V3'")
  (constraint track_width (min 0.40mm))
  (constraint clearance (min 0.20mm)))

(rule "Analog baseline clearance"
  (condition "A.NetClass == 'ADC_ANALOG'")
  (constraint clearance (min 0.25mm)))
